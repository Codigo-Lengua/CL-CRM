# Autor: Arlez Camilo Cerón Herrera · Versión 0.1 · 30 de octubre de 2026
# Copiar a .env.local (Next.js) y a .env (CLI de Prisma). Nunca subir valores reales.

# Ambiente: local, staging o production. Staging nunca envía mensajes reales a clientes.
APP_ENV=local

# Conexión a PostgreSQL (docker compose up -d db).
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Better Auth. El secreto debe tener al menos 32 caracteres aleatorios: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Nombre que ven los usuarios en el login, la app de autenticación y los correos.
NOMBRE_PRODUCTO="CRM CÓDIGO LENGUA"
